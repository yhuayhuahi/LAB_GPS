# ==============================================================================
# VARIABLES DE ENTORNO: SISTEMA DE GESTIÓN COMERCIAL QSY
# ==============================================================================

# Entorno de ejecución: 'development' | 'production' | 'test'
NODE_ENV=development

# Puerto de escucha del servidor HTTP
PORT=3000

# Motor de persistencia: 'sqlite' | 'postgres'
DB_CLIENT=sqlite

# Ruta del archivo SQLite (para desarrollo local)
SQLITE_DB_PATH=./data/qsy.db

# Cadena de conexión PostgreSQL (para producción / VPS / Docker)
# DATABASE_URL=postgresql://qsy_user:qsy_password@postgres:5432/qsy_db

# Clave secreta para firma criptográfica de tokens JWT (HMAC-SHA256)
JWT_SECRET=qsy_super_secret_jwt_key_for_development_purposes_only_2026

# Tiempo de vida de la sesión (8 horas = jornada laboral)
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS (separados por coma o '*' para desarrollo)
CORS_ORIGIN=*

# Versión del sistema / app móvil para chequeo de compatibilidad
APP_VERSION=1.0.0
